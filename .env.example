# Neon pooled connection string used by the application at runtime.
DATABASE_URL=

# Optional direct connection used by the schema setup command.
DATABASE_URL_UNPOOLED=

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Random 16+ character value. Vercel sends it to the daily schedule endpoint.
CRON_SECRET=

# Set these in Vercel Project Settings. Never expose them as NEXT_PUBLIC_*.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
